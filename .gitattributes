* text=auto

# Keep source, documentation, and Unix deployment scripts portable.
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.conf text eol=lf
*.service text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf

# Native Windows command files stay CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Knowledge assets and media are binary.
*.xlsx binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
