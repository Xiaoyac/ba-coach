# Copy to .env and fill in. Never commit .env.

# ---- App -------------------------------------------------------------
DEBUG=false
API_PREFIX=/api
# ---- Shared knowledge retrieval (restart backend workers to apply) ----
KNOWLEDGE_MIN_SCORE=0.1
# Set false for code-only production releases: no startup table creation/backfill.
STARTUP_DB_MAINTENANCE=true
# Switch only after the explicit V2 migration and release verification.
DATABASE_SCHEMA_VERSION=legacy
KNOWLEDGE_MIN_COVERAGE=0.12
KNOWLEDGE_RELATIVE_SCORE=0.2
KNOWLEDGE_MAX_PER_SOURCE=2
# Local rules only; false restores retrieval on every ordinary module turn.
KNOWLEDGE_INTENT_GATE_ENABLED=true
KNOWLEDGE_MEDIATOR_ENABLED=true
# Shared deterministic answer checks; buffers normal module output before delivery.
ANSWER_VALIDATOR_ENABLED=true
KNOWLEDGE_MEDIATOR_TIMEOUT_SECONDS=12
# Comma-separated exact origins the browser may call the API from. In
# production this is your real domain, e.g. https://coach.example.com
CORS_ORIGINS=http://localhost:3000

# Matched IN ADDITION to CORS_ORIGINS. The code default is an ngrok pattern,
# because a free tunnel gets a fresh random subdomain each time and cannot be
# listed ahead of time. ON A REAL SERVER LEAVE THIS EMPTY — the default would
# otherwise make any ngrok subdomain anybody creates an allowed origin.
# For local ngrok testing, set it to:
#   ^https://[a-z0-9-]+\.(ngrok-free\.app|ngrok\.io|ngrok\.app)$
CORS_ORIGIN_REGEX=

# ---- Provider selection ----------------------------------------------
# claude | deepseek | doubao
DEFAULT_PROVIDER=claude

# ---- Module router ----------------------------------------------------
# Which module handles the *next* turn is decided post-hoc by the fixed
# DeepSeek router (app/router_agent.py) after the visible reply is committed.
# This just caps that call's reply size — it's a small JSON object, so the
# default is plenty.
ROUTER_MAX_TOKENS=256
ROUTER_REASONING_MAX_TOKENS=1024

# The transition summarizer (app/graph/nodes.py) runs on that same cheap router
# model, but writes a standing long-term-memory entry instead of a one-line
# routing decision, so it gets a bigger cap. It fires as a detached
# background task on a module change and never blocks the reply.
SUMMARIZER_MAX_TOKENS=512

# ---- Claude (official Anthropic SDK) ---------------------------------
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-opus-5
# low | medium | high | xhigh | max — how hard the model thinks per turn
CLAUDE_EFFORT=medium
CLAUDE_MAX_TOKENS=8000
# Router model — keep this fast and non-thinking
CLAUDE_ROUTER_MODEL=claude-haiku-4-5

# ---- DeepSeek (official OpenAI SDK against api.deepseek.com) ---------
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-chat (V3) | deepseek-reasoner (R1)
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=4000
# Sampling temperature for the coach itself — the router always hardcodes 0
# regardless of this value, since routing must be deterministic. Leaving this
# unset does NOT default to a low value: the API's own default is 1.0, which
# is much too loose here — the module prompts are a gated procedure, and at
# 1.0 the model treats them as tone rather than rules. Raise only if replies
# feel mechanical.
DEEPSEEK_TEMPERATURE=0.3
# Must exist on DEEPSEEK_BASE_URL specifically — if that's a compatible-mode
# proxy (Alibaba DashScope, etc.) rather than api.deepseek.com directly, its
# model catalog is not DeepSeek's public one, and a plausible-looking name can
# 404 there. That failure is silent: the router call catches everything and
# returns "" on purpose, so a broken router model looks identical to "nothing
# useful to say" — routing just never advances past the current module, with
# no error anywhere but a log line. See the README's "Provider notes" section.
DEEPSEEK_ROUTER_MODEL=deepseek-chat

# Doubao / Volcengine Ark (both are required before Doubao is selectable)
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=
DOUBAO_MAX_TOKENS=4000
DOUBAO_TEMPERATURE=0.3
# Retains reasoning_content while reducing the long pre-answer thinking phase.
DOUBAO_REASONING_EFFORT=low
DOUBAO_ROUTER_MODEL=

# Clinical extraction (background) needs far more room than the summariser:
# module 1 alone asks for 11 fields. At 512 the reply was truncated mid-string
# and the whole record silently came back empty.
EXTRACTION_MAX_TOKENS=1800

# Screen every turn for self-harm signals BEFORE answering, and divert to the
# crisis reply when one fires. Costs one extra router-model call per turn —
# that is the price of the check being able to change what the person is told
# rather than only recording it afterwards. Set false to get the latency back;
# the module prompts keep their own risk-handling instructions either way.
RISK_GATE_ENABLED=true

# ---- Accounts --------------------------------------------------------
# How long a login lasts. Distinct from SESSION_TTL_SECONDS below, which is
# the conversation store's TTL — different questions, so don't share a value.
AUTH_SESSION_TTL_SECONDS=2592000

# ---- Email verification and password recovery ----------------------
# reset.bacoach.xyz must have an A record pointing at the web server and be
# included in its HTTPS certificate before production links are sent.
ACCOUNT_LINK_BASE_URL=https://reset.bacoach.xyz
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=3600
EMAIL_TOKEN_COOLDOWN_SECONDS=60

# SMTP credentials are never committed. Works with Aliyun DirectMail,
# enterprise mail, Resend SMTP, or another ordinary SMTP provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=BA行为激活教练
SMTP_STARTTLS=true
SMTP_USE_SSL=false

# Operator key for POST /api/auth/admin/reset, which resets any account's
# password without the old one.
#
# LEAVE THIS EMPTY unless you need it. Empty means that endpoint answers 404
# exactly as if it were never routed, so a deployment has no administrative
# back door until someone deliberately opts in.
#
# If you do set it: generate a random value, never a memorable phrase. A
# guessable key here is a key to every account's clinical record, since this
# endpoint is reachable by anyone who can reach the API. Under 32 characters
# and the endpoint refuses to serve (503) rather than run half-protected.
#
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# The terminal-only alternative needs no key at all and is preferable when
# you have shell access to the server:
#
#     python scripts/reset_password.py <username>
ADMIN_RESET_KEY=

# ---- Sessions --------------------------------------------------------
MAX_HISTORY_MESSAGES=40
SESSION_TTL_SECONDS=21600
# Set to use Redis instead of the in-process store (required for >1 worker)
# REDIS_URL=redis://localhost:6379/0

# ---- Memos (long-term memory) ----------------------------------------
# A self-hosted service (usememos.com), so there is no default URL — both of
# these must be set for long-term memory to be active. When either is blank,
# get_memos_manager() returns None and the graph runs with recall and
# summarization simply switched off; nothing errors.
# MEMOS_BASE_URL=https://memos.example.com
# MEMOS_API_KEY=

# ---- Database --------------------------------------------------------
# Stores the daily behavioral activation assessment. SQLite needs no service;
# swap in postgresql+asyncpg://user:pass@host/db for a real deployment.
DATABASE_URL=sqlite+aiosqlite:///./psychology.db
# Log every SQL statement. Debugging only.
DATABASE_ECHO=false
# Optional JSON map, USD per million tokens. Unlisted models keep cost NULL.
# LLM_PRICE_PER_MILLION_JSON={"deepseek-reasoner":{"input":0.55,"output":2.19,"reasoning":2.19}}
LLM_PRICE_PER_MILLION_JSON={}
