[Unit]
Description=BA Coach FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bacoach
Group=bacoach
WorkingDirectory=/opt/bacoach/current/backend
EnvironmentFile=/etc/bacoach/backend.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/bacoach/current/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
UMask=0027

[Install]
WantedBy=multi-user.target
