# Non-secret overrides: reuse the existing, verified Ark K3 provider.
# Empty dedicated overrides prevent the legacy Qwen channel from taking precedence.
REPLY_LEAD_PROVIDER=deepseek
REPLY_LEAD_MODEL=kimi-k3
REPLY_LEAD_BASE_URL=
REPLY_LEAD_API_KEY=
REPLY_LEAD_MAX_TOKENS=2048
REPLY_LEAD_TIMEOUT_SECONDS=8
